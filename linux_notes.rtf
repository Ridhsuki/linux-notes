\f0\fs28\b === CATATAN UTAMA PERINTAH LINUX ===\b0\fs24\par
\par
\b 1. Navigasi Navigasi Direktori\b0\par
\f1\fs20 - pwd : Melihat posisi folder aktif saat ini.\par
- ls -la : Menampilkan semua file termasuk file tersembunyi.\par
- cd /var/log : Pindah ke folder log sistem.\f0\fs24\par
\par
\b 2. Manajemen File\b0\par
\f1\fs20 - mkdir Catatan : Membuat folder baru bernama 'Catatan'.\par
- cp file.txt /tmp : Menyalin file ke folder temporary.\par
- rm -rf folder_lama : Menghapus folder beserta isinya secara paksa.\f0\fs24\par
\par
\b 3. Informasi Sistem\b0\par
\f1\fs20 - uname -a : Menampilkan versi Kernel Linux yang digunakan.\par
- df -h : Memeriksa sisa kapasitas harddisk (human-readable).\par
- top : Memantau proses background dan penggunaan RAM/CPU.\f0\fs24\par
}
